digraph SuggestSecurityPatches {
    graph [
        goal="Fix one security finding in this repository and deliver the change as a reviewed patch.",
        default_max_retries=0,
        default_fidelity="compact",
        stall_timeout="14400s",
        model_stylesheet="
            * { model: kimi-k3; reasoning_effort: low; }
            .generate { model: kimi-k3; reasoning_effort: high; }
            .verification { model: kimi-k3; reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]
    abort [
        shape=parallelogram,
        label="Abort after fatal deterministic failure",
        timeout="10s",
        script="echo 'suggest-security-patches stopped after a fatal deterministic failure.' >&2; exit 1"
    ]

    // Every deterministic node re-checks the support files it executes before
    // running them. The generator can write to this checkout, so a one-time
    // check in prepare would not survive its node. The graph and the @-loaded
    // prompts and schemas are resolved at run creation from the pushed
    // workflow version, out of the sandbox's reach.
    prepare [
        shape=parallelogram,
        label="Validate finding and resolve patch base",
        timeout="180s",
        output_schema="routing",
        stdin_source="graph.goal",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py prepare"
    ]

    generate [
        label="Implement the fix",
        class="generate",
        prompt="@prompts/generate.md.j2",
        output_schema="@schemas/generate.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        fidelity="compact",
        project_memory=false,
        max_visits=3
    ]
    assess_change [
        shape=parallelogram,
        label="Derive the changed set from Git",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.generate",
        max_visits=3,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py assess-change"
    ]

    // The one human question this workflow asks. A gate's question text is its
    // label, which is not templated; the generator's actual question reaches
    // the reviewer as the gate's context display, which Fabro fills from the
    // last agent stage's response.
    owner_gate [
        shape=hexagon,
        label="The fix needs a decision only you can make. The generator's question and its reasoning are shown above. Answer in your own words, or leave this to time out and the run will decline without a patch.",
        question_type="freeform",
        timeout="86400s",
        human.default_choice="no_patch"
    ]

    // Everything that decides what gets published is re-derived here from the
    // base commit carried in the run context, not from the engine's state file
    // in the writable checkout. assess_change must spend its one stdin on the
    // generator's output, which leaves its base forgeable; a forged base there
    // can misroute a run, but it cannot reach publication through this step.
    pin_review [
        shape=parallelogram,
        label="Re-derive the change from the trusted base and pin it",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.patch_base",
        max_visits=3,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py pin-review"
    ]

    verify [
        label="Review the change and state the three claims",
        class="verification",
        prompt="@prompts/verify.md.j2",
        output_schema="@schemas/patch-verdict.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=2
    ]
    merge_verdict [
        shape=parallelogram,
        label="Record claims and route",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.verify",
        max_visits=2,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py merge-verdict"
    ]

    adversarial [
        label="Attack the change itself",
        class="verification",
        prompt="@prompts/adversarial.md.j2",
        output_schema="@schemas/adversarial.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=2
    ]
    merge_adversarial [
        shape=parallelogram,
        label="Apply the adversarial result",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.adversarial",
        max_visits=2,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py merge-adversarial"
    ]

    revise [
        shape=parallelogram,
        label="Return the tree to base for a fresh attempt",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.patch_base",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py revise"
    ]

    // The pin — base commit and the fingerprint of the reviewed change — is
    // read back from the run context, which lives server-side. The engine's
    // own state file sits in the checkout the generator can write, so it is
    // not trusted for anything that decides what gets published.
    finalize [
        shape=parallelogram,
        label="Write the reviewed patch and its record",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.review_pin",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py finalize"
    ]
    no_patch [
        shape=parallelogram,
        label="Restore the tree and write the decline",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.patch_base",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py cab1d088f8a6dede40c4c234ddac4f538f3116a4726ee405e183d3db8a715b14 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 62621f33429d865b97f86794fc7f0466447076795be005685dcf7a0418450603 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py no-patch"
    ]

    start -> prepare
    prepare -> generate [condition="outcome=succeeded && context.finding_located=true"]
    prepare -> no_patch [condition="outcome=succeeded && context.finding_located=false"]
    prepare -> abort

    generate -> assess_change [condition="outcome=succeeded"]
    generate -> no_patch

    // assess_change only reports what the generator said; pin_review measures
    // the tree against the base carried in the run context and decides where
    // the run goes. One routing key, so the three outcomes cannot overlap.
    assess_change -> no_patch [condition="outcome=succeeded && context.declined=true"]
    assess_change -> pin_review [condition="outcome=succeeded && context.declined=false"]
    assess_change -> abort

    // Both ways out of the gate that are not an answer are routed by
    // condition, the first and most deterministic step of Fabro's transition
    // cascade. On timeout the handler sets preferred_label to the
    // human.default_choice value; a gate that fails closed — an interrupted or
    // unanswerable interview — arrives as outcome=failed. Neither may fall
    // through to the freeform edge, which would send an unattended run back to
    // the generator instead of declining.
    owner_gate -> no_patch [condition="preferred_label=no_patch || outcome=failed"]
    owner_gate -> generate [freeform=true]

    pin_review -> verify [condition="outcome=succeeded && context.pin_next=verify"]
    pin_review -> owner_gate [condition="outcome=succeeded && context.pin_next=ask"]
    pin_review -> no_patch [condition="outcome=succeeded && context.pin_next=decline"]
    pin_review -> abort

    verify -> merge_verdict [condition="outcome=succeeded"]
    verify -> no_patch

    merge_verdict -> adversarial [condition="outcome=succeeded && context.verdict_pass=true"]
    merge_verdict -> revise [condition="outcome=succeeded && context.retry=true"]
    merge_verdict -> no_patch [condition="outcome=succeeded && context.declined=true"]
    merge_verdict -> abort

    adversarial -> merge_adversarial [condition="outcome=succeeded"]
    adversarial -> no_patch

    merge_adversarial -> finalize [condition="outcome=succeeded && context.adversarial_clean=true"]
    merge_adversarial -> revise [condition="outcome=succeeded && context.retry=true"]
    merge_adversarial -> no_patch [condition="outcome=succeeded && context.declined=true"]
    merge_adversarial -> abort

    revise -> generate [condition="outcome=succeeded"]
    revise -> abort

    finalize -> exit [condition="outcome=succeeded"]
    finalize -> abort
    no_patch -> exit [condition="outcome=succeeded"]
    no_patch -> abort
}
