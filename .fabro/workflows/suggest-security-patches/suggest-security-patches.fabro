digraph SuggestSecurityPatches {
    graph [
        goal="Fix one security finding in this repository and deliver the change as a reviewed patch.",
        default_max_retries=0,
        default_fidelity="compact",
        on_failure="exit",
        stall_timeout="14400s",
        model_stylesheet="
            * { model: gpt-sol; reasoning_effort: low; }
            .planning { reasoning_effort: xhigh; }
            .implementation { reasoning_effort: high; }
            .review { reasoning_effort: high; }
            .consolidation { reasoning_effort: xhigh; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    prepare [
        shape=parallelogram,
        label="Validate finding and resolve patch base",
        timeout="180s",
        output_schema="routing",
        stdin_source="graph.goal",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py prepare"
    ]

    plan [
        label="Plan the fix",
        class="planning",
        prompt="@prompts/plan.md.j2",
        output_schema="@schemas/patch-plan.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_plan [
        label="Review and repair the plan",
        class="planning",
        prompt="@prompts/review-plan.md.j2",
        output_schema="@schemas/patch-plan.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    route_plan [
        shape=parallelogram,
        label="Route the reviewed plan",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.review_plan",
        max_visits=5,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py route-plan"
    ]
    check_plan_clean [
        shape=parallelogram,
        label="Confirm planning was read-only",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.patch_base",
        max_visits=5,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py check-plan-clean"
    ]
    generate [
        label="Implement the reviewed plan",
        class="implementation",
        prompt="@prompts/generate.md.j2",
        output_schema="@schemas/generate.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false
    ]
    assess_change [
        shape=parallelogram,
        label="Derive the changed set from Git",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.generate",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py assess-change"
    ]
    pin_review [
        shape=parallelogram,
        label="Pin the change for review",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.patch_base",
        max_visits=5,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py pin-review"
    ]

    review_fork [
        label="Review fan-out",
        shape=component,
        max_parallel=7,
        max_visits=5
    ]
    review_exploit_closure [
        label="Review exploit closure",
        class="review",
        prompt="@prompts/review-exploit-closure.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_new_attack_paths [
        label="Review new attack paths",
        class="review",
        prompt="@prompts/review-new-attack-paths.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_compatibility [
        label="Review compatibility and behavior",
        class="review",
        prompt="@prompts/review-compatibility.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_user_facing_behavior [
        label="Review user-facing behavior",
        class="review",
        prompt="@prompts/review-user-facing-behavior.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_completeness [
        label="Review completeness and evidence",
        class="review",
        prompt="@prompts/review-completeness.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_design_economy [
        label="Review design economy",
        class="review",
        prompt="@prompts/review-design-economy.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_performance_lifetime [
        label="Review performance and lifetime",
        class="review",
        prompt="@prompts/review-performance-lifetime.md.j2",
        output_schema="@schemas/review-lane.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    review_join [
        label="Reviews complete",
        shape=tripleoctagon,
        max_visits=5
    ]
    record_reviews [
        shape=parallelogram,
        label="Validate review coverage",
        timeout="180s",
        output_schema="routing",
        stdin_source="parallel.results",
        max_visits=5,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py record-reviews"
    ]
    consolidate_reviews [
        label="Consolidate reviews",
        class="consolidation",
        prompt="@prompts/consolidate-reviews.md.j2",
        output_schema="@schemas/review-consolidation.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=5
    ]
    merge_consolidation [
        shape=parallelogram,
        label="Route consolidated review",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.consolidate_reviews",
        max_visits=5,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py merge-consolidation"
    ]
    mark_fixup [
        shape=parallelogram,
        label="Record a review fixup",
        max_visits=4,
        timeout="180s",
        output_schema="routing",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py mark-fixup"
    ]
    fix_review_findings [
        label="Fix review findings",
        class="implementation",
        reasoning_effort="xhigh",
        prompt="@prompts/fix-review-findings.md.j2",
        output_schema="@schemas/generate.schema.json",
        output_retries=2,
        max_retries=2,
        timeout="10800s",
        project_memory=false,
        max_visits=4
    ]
    assess_fixup [
        shape=parallelogram,
        label="Assess the fixup",
        timeout="180s",
        output_schema="routing",
        stdin_source="context.output.fix_review_findings",
        max_visits=4,
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py assess-change"
    ]

    finalize [
        shape=parallelogram,
        label="Write the reviewed patch and its record",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.review_pin",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py finalize"
    ]
    no_patch [
        shape=parallelogram,
        label="Restore the tree and write the decline",
        timeout="300s",
        output_schema="routing",
        stdin_source="context.patch_base",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py c9da70191517ac7673afe9c56b832c930ed9a266cea1c0cbf7a5b36b995bf299 .fabro/workflows/suggest-security-patches/scripts/git_readonly.py 019877aad4e19975f8d16ff6e60152d69e8a31615ceb6858da8782677f043289 .fabro/workflows/suggest-security-patches/specs/patch-spec.md 22b50d735b18aa04c8feccb60ede8765750800defe3f96f434f66eedf25de2f7 && python3 .fabro/workflows/suggest-security-patches/scripts/suggest_patches.py no-patch"
    ]

    start -> prepare
    prepare -> plan [condition="outcome=succeeded && context.finding_located=true"]
    prepare -> no_patch [condition="outcome=succeeded && context.finding_located=false"]
    prepare -> exit
    plan -> review_plan
    review_plan -> route_plan
    route_plan -> check_plan_clean
    check_plan_clean -> generate [condition="outcome=succeeded && context.plan_tree_clean=true && context.plan_next=implement"]
    check_plan_clean -> no_patch [condition="outcome=succeeded && context.plan_tree_clean=false"]
    check_plan_clean -> no_patch [condition="outcome=succeeded && context.plan_next=decline"]
    check_plan_clean -> exit

    generate -> assess_change
    assess_change -> pin_review [condition="outcome=succeeded && context.declined=false"]
    assess_change -> no_patch [condition="outcome=succeeded && context.declined=true"]
    assess_change -> exit
    pin_review -> review_fork [condition="outcome=succeeded && context.pin_next=review"]
    pin_review -> no_patch [condition="outcome=succeeded && context.pin_next=decline"]
    pin_review -> finalize [condition="outcome=succeeded && context.pin_next=finalize"]
    pin_review -> exit

    review_fork -> review_exploit_closure
    review_fork -> review_new_attack_paths
    review_fork -> review_compatibility
    review_fork -> review_user_facing_behavior
    review_fork -> review_completeness
    review_fork -> review_design_economy
    review_fork -> review_performance_lifetime
    review_exploit_closure -> review_join
    review_new_attack_paths -> review_join
    review_compatibility -> review_join
    review_user_facing_behavior -> review_join
    review_completeness -> review_join
    review_design_economy -> review_join
    review_performance_lifetime -> review_join
    review_join -> record_reviews
    record_reviews -> consolidate_reviews
    consolidate_reviews -> merge_consolidation
    merge_consolidation -> finalize [condition="outcome=succeeded && context.review_next=clean"]
    merge_consolidation -> finalize [condition="outcome=succeeded && context.review_next=finalize"]
    merge_consolidation -> mark_fixup [condition="outcome=succeeded && context.review_next=fix"]
    merge_consolidation -> exit
    mark_fixup -> fix_review_findings
    fix_review_findings -> assess_fixup
    assess_fixup -> pin_review [condition="outcome=succeeded && context.declined=false"]
    assess_fixup -> no_patch [condition="outcome=succeeded && context.declined=true"]
    assess_fixup -> exit

    finalize -> exit
    no_patch -> exit
}
