{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patch implementation result",
  "type": "object",
  "required": ["summary", "behaviourChange", "refusal"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "changedFiles": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string" },
      "description": "Advisory only. The engine derives the changed set from Git."
    },
    "behaviourChange": { "type": ["string", "null"], "maxLength": 2000 },
    "refusal": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
