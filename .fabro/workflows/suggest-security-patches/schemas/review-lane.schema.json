{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One focused patch review",
  "type": "object",
  "required": ["summary", "findings", "residualRisks"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/finding" }
    },
    "residualRisks": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/residualRisk" }
    },
    "reviewedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["issue", "evidence", "requiredChange"],
      "additionalProperties": false,
      "properties": {
        "issue": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "requiredChange": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "residualRisk": {
      "type": "object",
      "required": ["issue", "evidence", "recommendedAction"],
      "additionalProperties": false,
      "properties": {
        "issue": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "recommendedAction": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
