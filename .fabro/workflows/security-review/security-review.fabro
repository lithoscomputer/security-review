digraph SecurityReview {
    graph [
        goal="Perform an adversarial, read-only security review of this repository and report only panel-verified findings.",
        default_max_retries=0,
        default_fidelity="compact",
        stall_timeout="3600s",
        model_stylesheet="
            * { model: sonnet; reasoning_effort: low; }
            .inventory { model: sonnet; reasoning_effort: medium; }
            .threat-model { model: opus; reasoning_effort: medium; }
            .research { model: opus; reasoning_effort: xhigh; }
            .verification { model: opus; reasoning_effort: xhigh; }
            .report-author { model: opus; reasoning_effort: xhigh; }
            .ensemble-a { model: gpt-5.6-sol; provider: openrouter; reasoning_effort: xhigh; }
            .ensemble-b { model: claude-opus-4-8; provider: openrouter; reasoning_effort: xhigh; }
            .ensemble-c { model: kimi-k3; provider: openrouter; reasoning_effort: high; }
            .ensemble-d { model: glm-5.2; provider: openrouter; reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]
    abort [
        shape=parallelogram,
        label="Abort after fatal deterministic failure",
        timeout="10s",
        script="echo 'Security-review workflow stopped after a fatal deterministic failure.' >&2; exit 1"
    ]

    prepare [
        shape=parallelogram,
        label="Resolve and size scan target",
        timeout="180s",
        output_schema="routing",
        script="python3 -c \"import hashlib,sys; pairs=list(zip(sys.argv[1::2],sys.argv[2::2])); sys.exit(0 if pairs and all(hashlib.sha256(open(path,'rb').read()).hexdigest()==expected for path,expected in pairs) else 91)\" .fabro/workflows/security-review/scripts/security_review.py 1ffc191d2d606eae40adcf90fd14120736a1520b70bd1a4460f776e429dbbd2d .fabro/workflows/security-review/scripts/git_readonly.py 6bafe2418234d7887d9f4726208bc9e50325bf34c5098c4a6ef508f1a5486ec5 .fabro/workflows/security-review/scripts/render_report.py e319c564b10b3b0f6ed58e8cc48d4df1bb3bc400256c3b2cc3138431678d16c3 .fabro/workflows/security-review/specs/report-spec.md 663c66cdbd519e6bdebf2dbc396c2d4c74e94a468c32228fcbbeb285c39d5a58 && python3 .fabro/workflows/security-review/scripts/security_review.py prepare --mode {{ inputs.mode }} --effort {{ inputs.effort }} --ensemble {{ inputs.ensemble }} --scope {{ inputs.scope }} --base {{ inputs.base }} --commit {{ inputs.commit }} --range {{ inputs.range }} --focus {{ inputs.focus }}"
    ]
    target_gate [shape=diamond, label="Target has work?"]

    inventory [
        label="Inventory",
        class="inventory",
        prompt="@prompts/inventory.md",
        output_schema="@schemas/inventory.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        fidelity="compact",
        project_memory=false,
        max_visits=2
    ]
    merge_inventory [
        shape=parallelogram,
        label="Merge inventory output",
        stdin_source="context.output.inventory",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge inventory",
        output_schema="routing",
        timeout="180s",
        max_visits=2
    ]
    inventory_gate [
        shape=diamond,
        label="Inventory complete or correct?",
        max_visits=2
    ]
    inventory_failed [
        shape=parallelogram,
        label="Record inventory-failed fallback",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py inventory-failed"
    ]

    plan_matrix [
        shape=parallelogram,
        label="Plan component matrix",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py plan-matrix"
    ]
    threat_gate [shape=diamond, label="Threat models needed?"]

    threat_models [
        shape=component,
        label="Threat models",
        for_each="context.threat_jobs",
        max_parallel=4,
        auto_status=true
    ]
    threat_model [
        label="Threat-model component",
        class="threat-model",
        prompt="@prompts/threat-model.md",
        output_schema="@schemas/threat-model.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    threat_join [shape=tripleoctagon, label="Gather threat-model outputs"]
    merge_threat [
        shape=parallelogram,
        label="Merge threat-model outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge threat",
        output_schema="routing",
        timeout="180s"
    ]
    zip_cells [
        shape=parallelogram,
        label="Build research and sweep cells",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py zip-cells"
    ]

    research_gate [shape=diamond, label="Researchers needed?"]
    research [
        shape=component,
        label="Research",
        for_each="context.research_jobs",
        max_parallel=8,
        auto_status=true
    ]
    researcher [
        label="Research component and category",
        class="research",
        prompt="@prompts/research.md",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1800s",
        project_memory=false
    ]
    research_join [shape=tripleoctagon, label="Gather research outputs"]
    merge_research [
        shape=parallelogram,
        label="Merge research outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge research",
        output_schema="routing",
        timeout="180s"
    ]
    research_a [
        shape=component,
        label="Research slot A",
        for_each="context.research_jobs_a",
        max_parallel=8,
        auto_status=true
    ]
    researcher_a [
        label="Research component and category with slot A",
        class="ensemble-a",
        prompt="@prompts/research.md",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1800s",
        project_memory=false
    ]
    research_join_a [shape=tripleoctagon, label="Gather slot A research outputs"]
    merge_research_a [
        shape=parallelogram,
        label="Merge slot A research outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble research-a",
        output_schema="routing",
        timeout="180s"
    ]
    research_b [
        shape=component,
        label="Research slot B",
        for_each="context.research_jobs_b",
        max_parallel=8,
        auto_status=true
    ]
    researcher_b [
        label="Research component and category with slot B",
        class="ensemble-b",
        prompt="@prompts/research.md",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1800s",
        project_memory=false
    ]
    research_join_b [shape=tripleoctagon, label="Gather slot B research outputs"]
    merge_research_b [
        shape=parallelogram,
        label="Merge slot B research outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble research-b",
        output_schema="routing",
        timeout="180s"
    ]

    sweep_gate [shape=diamond, label="Sweeps needed?"]
    sweep [
        shape=component,
        label="Gap-fill sweeps",
        for_each="context.sweep_jobs",
        max_parallel=3,
        auto_status=true
    ]
    sweeper [
        label="Gap-fill sweep",
        class="research",
        prompt="@prompts/sweep.md",
        output_schema="@schemas/findings.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1800s",
        project_memory=false
    ]
    sweep_join [shape=tripleoctagon, label="Gather sweep outputs"]
    merge_sweep [
        shape=parallelogram,
        label="Merge sweep outputs",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge sweep",
        output_schema="routing",
        timeout="180s"
    ]

    dedup_rank [
        shape=parallelogram,
        label="Deduplicate, rank, and cap candidates",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py dedup-rank"
    ]
    panel_gate [shape=diamond, label="Panel votes needed?"]
    panel [
        shape=component,
        label="Three-lens panel",
        for_each="context.verification_jobs",
        max_parallel=12,
        auto_status=true
    ]
    panel_verifier [
        label="Verify candidate",
        class="verification",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    panel_join [shape=tripleoctagon, label="Gather panel votes"]
    merge_panel [
        shape=parallelogram,
        label="Merge panel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge panel",
        output_schema="routing",
        timeout="180s"
    ]
    panel_a [
        shape=component,
        label="Panel slot A",
        for_each="context.verification_jobs_a",
        max_parallel=12,
        auto_status=true
    ]
    panel_verifier_a [
        label="Verify candidate with slot A",
        class="ensemble-a",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    panel_join_a [shape=tripleoctagon, label="Gather slot A panel votes"]
    merge_panel_a [
        shape=parallelogram,
        label="Merge slot A panel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble panel-a",
        output_schema="routing",
        timeout="180s"
    ]
    panel_b [
        shape=component,
        label="Panel slot B",
        for_each="context.verification_jobs_b",
        max_parallel=12,
        auto_status=true
    ]
    panel_verifier_b [
        label="Verify candidate with slot B",
        class="ensemble-b",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    panel_join_b [shape=tripleoctagon, label="Gather slot B panel votes"]
    merge_panel_b [
        shape=parallelogram,
        label="Merge slot B panel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble panel-b",
        output_schema="routing",
        timeout="180s"
    ]
    panel_c [
        shape=component,
        label="Panel slot C",
        for_each="context.verification_jobs_c",
        max_parallel=12,
        auto_status=true
    ]
    panel_verifier_c [
        label="Verify candidate with slot C",
        class="ensemble-c",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    panel_join_c [shape=tripleoctagon, label="Gather slot C panel votes"]
    merge_panel_c [
        shape=parallelogram,
        label="Merge slot C panel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble panel-c",
        output_schema="routing",
        timeout="180s"
    ]
    tally [
        shape=parallelogram,
        label="Tally initial panels",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py tally"
    ]

    effort_gate [shape=diamond, label="Max effort?"]
    repanel_gate [shape=diamond, label="Marginal keeps need repanel?"]
    repanel [
        shape=component,
        label="Repanel marginal keeps",
        for_each="context.repanel_jobs",
        max_parallel=12,
        auto_status=true
    ]
    repanel_verifier [
        label="Recheck marginal candidate",
        class="verification",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    repanel_join [shape=tripleoctagon, label="Gather repanel votes"]
    merge_repanel [
        shape=parallelogram,
        label="Merge repanel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge repanel",
        output_schema="routing",
        timeout="180s"
    ]
    repanel_a [
        shape=component,
        label="Repanel slot A",
        for_each="context.repanel_jobs_a",
        max_parallel=12,
        auto_status=true
    ]
    repanel_verifier_a [
        label="Recheck marginal candidate with slot A",
        class="ensemble-a",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    repanel_join_a [shape=tripleoctagon, label="Gather slot A repanel votes"]
    merge_repanel_a [
        shape=parallelogram,
        label="Merge slot A repanel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble repanel-a",
        output_schema="routing",
        timeout="180s"
    ]
    repanel_b [
        shape=component,
        label="Repanel slot B",
        for_each="context.repanel_jobs_b",
        max_parallel=12,
        auto_status=true
    ]
    repanel_verifier_b [
        label="Recheck marginal candidate with slot B",
        class="ensemble-b",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    repanel_join_b [shape=tripleoctagon, label="Gather slot B repanel votes"]
    merge_repanel_b [
        shape=parallelogram,
        label="Merge slot B repanel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble repanel-b",
        output_schema="routing",
        timeout="180s"
    ]
    repanel_c [
        shape=component,
        label="Repanel slot C",
        for_each="context.repanel_jobs_c",
        max_parallel=12,
        auto_status=true
    ]
    repanel_verifier_c [
        label="Recheck marginal candidate with slot C",
        class="ensemble-c",
        prompt="@prompts/verify.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    repanel_join_c [shape=tripleoctagon, label="Gather slot C repanel votes"]
    merge_repanel_c [
        shape=parallelogram,
        label="Merge slot C repanel votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge-ensemble repanel-c",
        output_schema="routing",
        timeout="180s"
    ]
    adversarial_plan [
        shape=parallelogram,
        label="Apply repanel and plan red-team round",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py adversarial-plan"
    ]

    redteam_gate [shape=diamond, label="Red-team votes needed?"]
    redteam [
        shape=component,
        label="Red-team every survivor",
        for_each="context.redteam_jobs",
        max_parallel=4,
        auto_status=true
    ]
    redteam_verifier [
        label="Red-team candidate",
        class="verification",
        prompt="@prompts/redteam.md",
        output_schema="@schemas/verdict.schema.json",
        output_retries=2,
        max_retries=2,
        auto_status=true,
        timeout="1200s",
        project_memory=false
    ]
    redteam_join [shape=tripleoctagon, label="Gather red-team votes"]
    merge_redteam [
        shape=parallelogram,
        label="Merge red-team votes",
        stdin_source="context.parallel.results",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py merge redteam",
        output_schema="routing",
        timeout="180s"
    ]

    final_tally [
        shape=parallelogram,
        label="Assemble stable findings, votes, and coverage",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py final-tally"
    ]
    report_author [
        label="Security Lead writes human report",
        class="report-author",
        prompt="@prompts/report.md",
        output_schema="routing",
        output_retries=2,
        max_retries=2,
        timeout="1200s",
        fidelity="truncate",
        project_memory=false
    ]
    report_author_d [
        label="Security Lead slot D writes human report",
        class="ensemble-d",
        prompt="@prompts/report.md",
        output_schema="routing",
        output_retries=2,
        max_retries=2,
        timeout="1200s",
        fidelity="truncate",
        project_memory=false
    ]
    render_report [
        shape=parallelogram,
        label="Original deterministic renderer writes JSONL and stamp",
        timeout="180s",
        output_schema="routing",
        script="python3 .fabro/workflows/security-review/scripts/security_review.py render-report"
    ]

    start -> prepare
    prepare -> target_gate [condition="outcome=succeeded"]
    prepare -> abort
    target_gate -> exit [condition="context.empty_target=true"]
    target_gate -> inventory [condition="context.use_inventory=true"]
    target_gate -> plan_matrix

    inventory -> merge_inventory [condition="outcome=succeeded"]
    inventory -> inventory_failed
    inventory_failed -> plan_matrix [condition="outcome=succeeded"]
    inventory_failed -> abort
    merge_inventory -> inventory_gate [condition="outcome=succeeded"]
    merge_inventory -> abort
    inventory_gate -> inventory [condition="context.inventory_correction=true"]
    inventory_gate -> plan_matrix

    plan_matrix -> threat_gate [condition="outcome=succeeded"]
    plan_matrix -> abort
    threat_gate -> threat_models [condition="context.run_threat_models=true"]
    threat_gate -> research_gate
    threat_models -> threat_model [fidelity="truncate"]
    threat_model -> threat_join -> merge_threat
    merge_threat -> zip_cells [condition="outcome=succeeded"]
    merge_threat -> abort
    zip_cells -> research_gate [condition="outcome=succeeded"]
    zip_cells -> abort

    research_gate -> research_a [condition="context.run_ensemble_research=true"]
    research_gate -> research [condition="context.run_standard_research=true"]
    research_gate -> sweep_gate
    research -> researcher [fidelity="truncate"]
    researcher -> research_join -> merge_research
    merge_research -> sweep_gate [condition="outcome=succeeded"]
    merge_research -> abort
    research_a -> researcher_a [fidelity="truncate"]
    researcher_a -> research_join_a -> merge_research_a
    merge_research_a -> research_b [condition="outcome=succeeded"]
    merge_research_a -> abort
    research_b -> researcher_b [fidelity="truncate"]
    researcher_b -> research_join_b -> merge_research_b
    merge_research_b -> sweep_gate [condition="outcome=succeeded"]
    merge_research_b -> abort

    sweep_gate -> sweep [condition="context.run_sweeps=true"]
    sweep_gate -> dedup_rank
    sweep -> sweeper [fidelity="truncate"]
    sweeper -> sweep_join -> merge_sweep
    merge_sweep -> dedup_rank [condition="outcome=succeeded"]
    merge_sweep -> abort

    dedup_rank -> panel_gate [condition="outcome=succeeded"]
    dedup_rank -> abort
    panel_gate -> panel_a [condition="context.run_ensemble_panel=true"]
    panel_gate -> panel [condition="context.run_standard_panel=true"]
    panel_gate -> tally
    panel -> panel_verifier [fidelity="truncate"]
    panel_verifier -> panel_join -> merge_panel
    merge_panel -> tally [condition="outcome=succeeded"]
    merge_panel -> abort
    panel_a -> panel_verifier_a [fidelity="truncate"]
    panel_verifier_a -> panel_join_a -> merge_panel_a
    merge_panel_a -> panel_b [condition="outcome=succeeded"]
    merge_panel_a -> abort
    panel_b -> panel_verifier_b [fidelity="truncate"]
    panel_verifier_b -> panel_join_b -> merge_panel_b
    merge_panel_b -> panel_c [condition="outcome=succeeded"]
    merge_panel_b -> abort
    panel_c -> panel_verifier_c [fidelity="truncate"]
    panel_verifier_c -> panel_join_c -> merge_panel_c
    merge_panel_c -> tally [condition="outcome=succeeded"]
    merge_panel_c -> abort

    tally -> effort_gate [condition="outcome=succeeded"]
    tally -> abort
    effort_gate -> repanel_gate [condition="context.max_effort=true"]
    effort_gate -> final_tally
    repanel_gate -> repanel_a [condition="context.run_ensemble_repanel=true"]
    repanel_gate -> repanel [condition="context.run_standard_repanel=true"]
    repanel_gate -> adversarial_plan
    repanel -> repanel_verifier [fidelity="truncate"]
    repanel_verifier -> repanel_join -> merge_repanel
    merge_repanel -> adversarial_plan [condition="outcome=succeeded"]
    merge_repanel -> abort
    repanel_a -> repanel_verifier_a [fidelity="truncate"]
    repanel_verifier_a -> repanel_join_a -> merge_repanel_a
    merge_repanel_a -> repanel_b [condition="outcome=succeeded"]
    merge_repanel_a -> abort
    repanel_b -> repanel_verifier_b [fidelity="truncate"]
    repanel_verifier_b -> repanel_join_b -> merge_repanel_b
    merge_repanel_b -> repanel_c [condition="outcome=succeeded"]
    merge_repanel_b -> abort
    repanel_c -> repanel_verifier_c [fidelity="truncate"]
    repanel_verifier_c -> repanel_join_c -> merge_repanel_c
    merge_repanel_c -> adversarial_plan [condition="outcome=succeeded"]
    merge_repanel_c -> abort

    adversarial_plan -> redteam_gate [condition="outcome=succeeded"]
    adversarial_plan -> abort
    redteam_gate -> redteam [condition="context.run_redteam=true"]
    redteam_gate -> final_tally
    redteam -> redteam_verifier [fidelity="truncate"]
    redteam_verifier -> redteam_join -> merge_redteam
    merge_redteam -> final_tally [condition="outcome=succeeded"]
    merge_redteam -> abort

    final_tally -> report_author_d [condition="context.run_ensemble_report=true"]
    final_tally -> report_author [condition="context.run_standard_report=true"]
    final_tally -> abort
    report_author -> render_report [condition="outcome=succeeded"]
    report_author -> abort
    report_author_d -> render_report [condition="outcome=succeeded"]
    report_author_d -> abort
    render_report -> exit [condition="outcome=succeeded"]
    render_report -> abort
}
